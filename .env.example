# Copie para .env (não versionado).
# Local: use o perfil OAuth da Databricks CLI (databricks auth login --profile DESLOC)
DATABRICKS_HOST=https://dbc-097964b0-0fea.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DESLOC
# Produção (Render): deixe o profile vazio e defina o token como secret da plataforma
# DATABRICKS_TOKEN=
DATABRICKS_ENDPOINT=desloc-corrida
CORS_ORIGINS=http://localhost:5173
PREDICTION_LOG_PATH=logs/previsoes.jsonl
