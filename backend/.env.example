# Copie para ../.env (raiz do repositório) ou exporte as variáveis no ambiente.
DATABRICKS_HOST=https://dbc-097964b0-0fea.cloud.databricks.com
# Produção: token de acesso (tem precedência sobre o perfil)
DATABRICKS_TOKEN=
# Uso local: perfil do ~/.databrickscfg autenticado via OAuth (databricks auth login --profile DESLOC)
DATABRICKS_CONFIG_PROFILE=DESLOC
DATABRICKS_ENDPOINT=desloc-corrida
CORS_ORIGINS=http://localhost:5173
PREDICTION_LOG_PATH=logs/previsoes.jsonl
PORT=8000
